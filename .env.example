# SERV Reasoning — create at https://console.openserv.ai/settings/keys
SERV_API_KEY=
SERV_MODEL=gpt-6-luna

# Agent wallet (Base Sepolia). Generate with: npm run keygen
AGENT_PRIVATE_KEY=
# User-owned savings wallet that receives round-ups (Spare never holds its key)
STASH_ADDRESS=
# Demo merchant address that receives payments
MERCHANT_ADDRESS=

NETWORK_ID=base-sepolia
RPC_URL=https://sepolia.base.org
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Hard policy caps (USD) — enforced in code, never by the model
MAX_ROUNDUP_PER_PAYMENT=2
DAILY_ROUNDUP_CAP=10
WALLET_FLOOR=1
SWEEP_THRESHOLD=3

PORT=3000
